# Environment file for `docker-compose up` - copy to `.env` in this same
# directory and fill in real values. NEVER commit the real `.env` file.
#
# This is only consumed by docker-compose.yml. If you run the backend and
# frontend directly (not via Docker), use backend/.env.example and
# frontend/.env.example instead.

# --- MySQL ---
DB_NAME=lalitha_surya_sweets
MYSQL_ROOT_PASSWORD=change-me-root-password
DB_USERNAME=sweets_app
DB_PASSWORD=change-me-app-password

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=prod
JPA_DDL_AUTO=update

# --- Mail (Gmail example: use an App Password, never your real account password) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-shop@gmail.com
MAIL_PASSWORD=change-me

# --- WhatsApp notifications (optional local bridge) ---
WHATSAPP_ADMIN_NUMBER=91XXXXXXXXXX
WHATSAPP_GATEWAY_URL=http://localhost:3000/send

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me

# --- Initial admin account (seeded once on an empty database) ---
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change-me-strong-password

# --- JWT (admin auth) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-value

# --- Public URLs ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8080
