# Copy this file to `.env` (or export these as real environment variables /
# secrets in your deployment platform) and fill in real values.
# NEVER commit an actual .env file - it is already covered by .gitignore.

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/lalitha_surya_sweets
DB_USERNAME=root
DB_PASSWORD=change-me

# --- JPA ---
# "update" is fine for local dev; use a real migration tool (Flyway/Liquibase)
# and set this to "validate" for production.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# --- Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Mail (Gmail example: use an App Password, not your real password) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-shop@gmail.com
MAIL_PASSWORD=change-me

# --- WhatsApp notifications (local bridge, e.g. a whatsapp-web.js gateway) ---
WHATSAPP_ADMIN_NUMBER=91XXXXXXXXXX
WHATSAPP_GATEWAY_URL=http://localhost:3000/send

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me

# --- JWT (admin auth) ---
# Generate a long random value, e.g.: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-value
JWT_EXPIRATION_MS=86400000

# --- Initial admin account (seeded once on an empty database) ---
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change-me

# --- CORS / frontend / backend URLs ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8080
